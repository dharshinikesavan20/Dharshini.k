import java.util.*;
public class Main
{
	public static void main(String[] args) {
	Scanner sc=new Scanner(System.in);
	int s=sc.nextInt();
	int arr[]=new int[s];
	for(int i=0;i<s;i++){
	    arr[i]=sc.nextInt();
	 }
    for(int i=0;i<s-2;i+=2){
                int temp=arr[i];
                arr[i]=arr[i+2];
                arr[i+2]=temp;
            }
             for(int i=1;i<s-2;i+=2){
                int temp=arr[i];
                arr[i]=arr[i+2];
                arr[i+2]=temp;
            }
	
	    for(int x:arr){
	        System.out.println(x+" ");
	}
}
}
